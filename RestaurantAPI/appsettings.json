{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=restaurant_booking;Username=postgres;Password=postgres"
  },

  "AppSettings": {
    "FrontendUrl": "http://localhost:5173"
  },

  "Jwt": {
    "Key": "REPLACE_WITH_JWT_SECRET",
    "Issuer": "RestaurantAPI",
    "Audience": "RestaurantClient",
    "ExpireMinutes": 1440,
    "RefreshTokenExpireDays": 7
  },

  "VNPay": {
    "TmnCode": "OAAXIKJN",
    "HashSecret": "REPLACE_WITH_VNPAY_SANDBOX_HASH_SECRET",
    "Url": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:5058/api/payment/vnpay-callback",
    "Version": "2.1.0",
    "Command": "pay"
  },

  "MoMo": {
    "PartnerCode": "MOMO",
    "AccessKey": "REPLACE_WITH_MOMO_ACCESS_KEY",
    "SecretKey": "REPLACE_WITH_MOMO_SECRET_KEY",
    "Endpoint": "https://test-payment.momo.vn/v2/gateway/api/create",
    "ReturnUrl": "http://localhost:5058/api/payment/momo-callback",
    "IpnUrl": "http://localhost:5058/api/payment/momo-ipn"
  },

  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "noreply@restaurant.com",
    "SenderName": "Restaurant Booking System",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },

  "FileUpload": {
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
    "UploadPath": "wwwroot/uploads",
    "MenuItemsPath": "wwwroot/uploads/menu-items",
    "AvatarsPath": "wwwroot/uploads/avatars"
  },

  "BookingSettings": {
    "MinAdvanceHours": 0,
    "CancellationHours": 4,
    "CheckInWindowMinutes": 30,
    "LateCheckInWindowMinutes": 60,
    "NoShowGraceMinutes": 30,
    "BookingDurationHours": 2,
    "DefaultDepositAmount": 50000,
    "MaxGuestsPerBooking": 20
  },

  "SystemSettings": {
    "DefaultPageSize": 10,
    "MaxPageSize": 100,
    "EnableEmailNotifications": true,
    "EnableSmsNotifications": false,
    "MaintenanceMode": false
  }
}
